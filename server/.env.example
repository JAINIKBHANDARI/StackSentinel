PORT=5000
# For local development:
MONGO_URI=mongodb://localhost:27017/stacksentinel
# For cloud MongoDB Atlas (replace <user>, <password>, and <cluster>):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/stacksentinel?retryWrites=true&w=majority

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Jenkins CI/CD Webhook Security Token
JENKINS_WEBHOOK_SECRET=stacksentinel_jenkins_secret_2026
